# 1. 环境变量文件（核心：避免密码泄露）
backend/.env
.env.local
.env.*.local
.env.example # 若有示例文件可取消注释（建议保留示例文件并提交）

# 2. Node.js 相关
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# 3. Python 相关
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
*.egg-info/
pip-log.txt

# 4. 日志文件
*.log
system_logs/
audit_logs/

# 5. 编辑器/IDE 配置
.idea/
.vscode/
*.swp
*.swo
.DS_Store  # Mac 系统特有
Thumbs.db  # Windows 系统特有

# 6. 临时文件/构建产物
tmp/
temp/
dist/
build/
# 忽略用户上传的图片/视频等临时文件
backend/uploads/
uploads/